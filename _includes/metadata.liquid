{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% assign page_description = page.description | default: site.description %}
{% if page.url == '/' %}
  {% assign page_title = author_name %}
{% else %}
  {% capture page_title %}{{ page.title }} | {{ author_name }}{% endcapture %}
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ page_title | strip }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ page_description | escape }}">
<meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% if page.sitemap == false %}
  <meta name="robots" content="noindex, follow">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ author_name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | strip | escape }}">
  <meta property="og:url" content="{{ page.url | absolute_url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  <meta property="og:image" content="{{ page.og_image | default: site.og_image }}">
  <meta property="og:locale" content="{{ site.lang }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page_title | strip | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">
  <meta name="twitter:image" content="{{ page.og_image | default: site.og_image }}">
{% endif %}

{% if site.serve_schema_org %}
  <script type="application/ld+json">
    {% if page.url == '/' %}
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": "{{ site.url }}/",
        "name": {{ author_name | jsonify }},
        "description": {{ page_description | jsonify }},
        "mainEntity": {
          "@type": "Person",
          "name": {{ author_name | jsonify }},
          "url": "{{ site.url }}/",
          "image": "{{ '/assets/img/me.png' | absolute_url }}",
          "jobTitle": "Research Associate in Theoretical and Computational Chemistry",
          "affiliation": {
            "@type": "Organization",
            "name": "University of Cambridge",
            "url": "https://www.cam.ac.uk/"
          },
          "sameAs": [
            "https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}",
            "https://orcid.org/{{ site.data.socials.orcid_id }}",
            "https://github.com/{{ site.data.socials.github_username }}"
          ]
        }
      }
    {% else %}
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": "{{ page.url | absolute_url }}",
        "name": {{ page_title | strip | jsonify }},
        "description": {{ page_description | jsonify }},
        "isPartOf": {
          "@type": "WebSite",
          "url": "{{ site.url }}/",
          "name": {{ author_name | jsonify }}
        }
      }
    {% endif %}
  </script>
{% endif %}
